# Copy to .env.local and set your Neon connection string (Dashboard → project → Connection string).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Optionnel : fusionner les avis Google avec ceux de la base (affichage uniquement, rien n’est écrit en base).
# Google Cloud : activer « Places API (New) », créer une clé API ; Place ID de la fiche (format ChIJ…).
# https://developers.google.com/maps/documentation/places/web-service/place-id
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# Optionnel : heures entre deux appels Google (défaut 48). Pas un horaire fixe (ex. minuit) : le délai repart après le dernier appel réussi.
# GOOGLE_REVIEWS_CACHE_HOURS=48
